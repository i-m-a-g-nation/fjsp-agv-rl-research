# Source files: LF on every platform.
*.py text eol=lf

# Experiment inputs and outputs keep their exact bytes: manifests record
# SHA-256 hashes, so Git must never convert newlines in these files.
experiments/inputs/** -text
experiments/results/** -text
experiments/archive/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
