# DeepSeek official API. Fill your DeepSeek key locally; never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash

# Project default for short bounded calls; provider default is enabled/high.
# enabled is supported, but does not increase the existing token/time budget.
LLM_THINKING_MODE=disabled

# Local retrieval: this setup does not request remote embeddings.
RAG_EMBEDDING_BACKEND=hybrid_local
