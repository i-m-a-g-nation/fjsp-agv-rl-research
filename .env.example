# DeepSeek official API. Fill your DeepSeek key locally; never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash

# Explicit maximum thinking; reasoning tokens share the existing output cap.
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=max
# Explicit per-request profile within the existing hard ceilings.
# Cumulative session budgets and the zero-retry default remain unchanged.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=60

# Local retrieval: this setup does not request remote embeddings.
RAG_EMBEDDING_BACKEND=hybrid_local
